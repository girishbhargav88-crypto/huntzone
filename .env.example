# ---- Server (server/index.ts) ----
PORT=3001
# Comma separated list of allowed web origins (use * for local dev only)
CORS_ORIGINS=*

# ---- Client (Vite; must start with VITE_) ----
# Leave empty in dev (auto: same host, port 3001) and when the server also serves the build.
# Set to your deployed backend (HTTPS/WSS) when the frontend is on Firebase Hosting.
VITE_SERVER_URL=
# Optional tile override. Default is OpenStreetMap's public tile server (light use only!).
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# ---- Optional Firebase (leave empty to play without it) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
